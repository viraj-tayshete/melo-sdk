{
  "meloCapabilityModel": {
    "version": "2.0",
    "sdkVersion": "0.2.0",
    "description": "Single source of truth for what a Melo robot can do. Melo Blocks must expose these capabilities and only these; each block generates the 'codegen' template with {name} placeholders replaced by input values (enum inputs use the value's 'code', bools use true/false). tools/check_capabilities.py checks this file against src/Melo.h and src/MeloTypes.h.",
    "capabilities": [
      {
        "id": "MOVE_FORWARD",
        "category": "drive",
        "description": "Drive forward until stopped",
        "arduinoApi": "Melo.moveForward(speed)",
        "codegen": "Melo.moveForward({speed});",
        "blockLabel": "Move Forward",
        "inputs": [
          {
            "name": "speed",
            "type": "uint8",
            "unit": "percent",
            "min": 0,
            "max": 100,
            "description": "Wheel speed",
            "default": 70
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "MOVE_BACKWARD",
        "category": "drive",
        "description": "Drive backward until stopped",
        "arduinoApi": "Melo.moveBackward(speed)",
        "codegen": "Melo.moveBackward({speed});",
        "blockLabel": "Move Backward",
        "inputs": [
          {
            "name": "speed",
            "type": "uint8",
            "unit": "percent",
            "min": 0,
            "max": 100,
            "description": "Wheel speed",
            "default": 70
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "TURN_LEFT",
        "category": "drive",
        "description": "Spin left on the spot until stopped (a speed, not an angle)",
        "arduinoApi": "Melo.turnLeft(speed)",
        "codegen": "Melo.turnLeft({speed});",
        "blockLabel": "Turn Left",
        "inputs": [
          {
            "name": "speed",
            "type": "uint8",
            "unit": "percent",
            "min": 0,
            "max": 100,
            "description": "Wheel speed",
            "default": 60
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "TURN_RIGHT",
        "category": "drive",
        "description": "Spin right on the spot until stopped (a speed, not an angle)",
        "arduinoApi": "Melo.turnRight(speed)",
        "codegen": "Melo.turnRight({speed});",
        "blockLabel": "Turn Right",
        "inputs": [
          {
            "name": "speed",
            "type": "uint8",
            "unit": "percent",
            "min": 0,
            "max": 100,
            "description": "Wheel speed",
            "default": 60
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "STOP",
        "category": "drive",
        "description": "Stop both wheels",
        "arduinoApi": "Melo.stop()",
        "codegen": "Melo.stop();",
        "blockLabel": "Stop",
        "inputs": [],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "SET_WHEEL",
        "category": "drive",
        "description": "Set one wheel, or both, directly",
        "arduinoApi": "Melo.wheel(side, speed)",
        "codegen": "Melo.wheel({side}, {speed});",
        "blockLabel": "Set Wheel",
        "inputs": [
          {
            "name": "side",
            "type": "enum",
            "values": [
              {
                "label": "Left",
                "code": "WHEEL_LEFT"
              },
              {
                "label": "Right",
                "code": "WHEEL_RIGHT"
              },
              {
                "label": "Both",
                "code": "WHEEL_BOTH"
              }
            ],
            "description": "Which wheel"
          },
          {
            "name": "speed",
            "type": "int8",
            "unit": "percent",
            "min": -100,
            "max": 100,
            "description": "Positive = forward, negative = backward, 0 = stop"
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "FOLLOW_LINE",
        "category": "drive",
        "description": "Follow a dark line with the IR sensor until the line is lost",
        "arduinoApi": "Melo.followLine(speed)",
        "codegen": "while (Melo.followLine({speed})) { }",
        "blockLabel": "Follow Line",
        "inputs": [
          {
            "name": "speed",
            "type": "uint8",
            "unit": "percent",
            "min": 0,
            "max": 100,
            "description": "Cruising speed",
            "default": 50
          }
        ],
        "outputs": [],
        "blocking": true,
        "errors": [
          "MELO_ERR_NOT_INIT",
          "MELO_ERR_LINE_LOST"
        ]
      },
      {
        "id": "IR_DETECTED",
        "category": "sensor",
        "description": "IR sensor sees a reflection",
        "arduinoApi": "Melo.irDetected()",
        "codegen": "Melo.irDetected()",
        "blockLabel": "IR Sees Reflection?",
        "inputs": [],
        "outputs": [
          {
            "name": "detected",
            "type": "bool",
            "description": "true when IR is reflected back"
          }
        ],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "LINE_DETECTED",
        "category": "sensor",
        "description": "IR sensor is over a dark line",
        "arduinoApi": "Melo.lineDetected()",
        "codegen": "Melo.lineDetected()",
        "blockLabel": "On Line?",
        "inputs": [],
        "outputs": [
          {
            "name": "onLine",
            "type": "bool",
            "description": "true when over a dark line (no reflection)"
          }
        ],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "OBSTACLE_DETECTED",
        "category": "sensor",
        "description": "Something is in front of the IR sensor (not a distance)",
        "arduinoApi": "Melo.obstacleDetected()",
        "codegen": "Melo.obstacleDetected()",
        "blockLabel": "Obstacle Ahead?",
        "inputs": [],
        "outputs": [
          {
            "name": "blocked",
            "type": "bool",
            "description": "true when something reflects IR"
          }
        ],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "READ_LIGHT",
        "category": "sensor",
        "description": "Light level",
        "arduinoApi": "Melo.readLight()",
        "codegen": "Melo.readLight()",
        "blockLabel": "Light Level",
        "inputs": [],
        "outputs": [
          {
            "name": "level",
            "type": "uint8",
            "unit": "percent",
            "min": 0,
            "max": 100,
            "description": "0 = dark, 100 = bright"
          }
        ],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "SET_LED",
        "category": "output",
        "description": "Turn the LED on or off",
        "arduinoApi": "Melo.led(on)",
        "codegen": "Melo.led({on});",
        "blockLabel": "Set LED",
        "inputs": [
          {
            "name": "on",
            "type": "bool",
            "description": "true = on, false = off"
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "BLINK_LED",
        "category": "output",
        "description": "Blink the LED",
        "arduinoApi": "Melo.ledBlink(times, onMs, offMs)",
        "codegen": "Melo.ledBlink({times}, {onMs}, {offMs});",
        "blockLabel": "Blink LED",
        "inputs": [
          {
            "name": "times",
            "type": "uint8",
            "unit": "count",
            "min": 1,
            "max": 255,
            "description": "Number of blinks",
            "default": 3
          },
          {
            "name": "onMs",
            "type": "uint16",
            "unit": "ms",
            "min": 1,
            "max": 65535,
            "description": "On time",
            "default": 200
          },
          {
            "name": "offMs",
            "type": "uint16",
            "unit": "ms",
            "min": 0,
            "max": 65535,
            "description": "Off time; 0 = same as on time",
            "default": 0
          }
        ],
        "outputs": [],
        "blocking": true,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "BEEP",
        "category": "output",
        "description": "Play a tone and wait for it to finish",
        "arduinoApi": "Melo.beep(frequencyHz, durationMs)",
        "codegen": "Melo.beep({frequencyHz}, {durationMs});",
        "blockLabel": "Beep",
        "inputs": [
          {
            "name": "frequencyHz",
            "type": "uint16",
            "unit": "Hz",
            "min": 0,
            "max": 20000,
            "description": "Pitch; 0 = silence",
            "default": 1000
          },
          {
            "name": "durationMs",
            "type": "uint32",
            "unit": "ms",
            "min": 0,
            "max": 60000,
            "description": "Length",
            "default": 500
          }
        ],
        "outputs": [],
        "blocking": true,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "START_BEEP",
        "category": "output",
        "description": "Start a continuous tone",
        "arduinoApi": "Melo.startBeep(frequencyHz)",
        "codegen": "Melo.startBeep({frequencyHz});",
        "blockLabel": "Start Tone",
        "inputs": [
          {
            "name": "frequencyHz",
            "type": "uint16",
            "unit": "Hz",
            "min": 20,
            "max": 20000,
            "description": "Pitch",
            "default": 1000
          }
        ],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "STOP_BEEP",
        "category": "output",
        "description": "Stop the tone",
        "arduinoApi": "Melo.stopBeep()",
        "codegen": "Melo.stopBeep();",
        "blockLabel": "Stop Tone",
        "inputs": [],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      },
      {
        "id": "WAIT",
        "category": "control",
        "description": "Pause the program",
        "arduinoApi": "delay(ms)",
        "codegen": "delay({ms});",
        "blockLabel": "Wait",
        "inputs": [
          {
            "name": "ms",
            "type": "uint32",
            "unit": "ms",
            "min": 0,
            "max": 600000,
            "description": "How long to wait",
            "default": 1000
          }
        ],
        "outputs": [],
        "blocking": true,
        "errors": [],
        "external": true
      },
      {
        "id": "END_PROGRAM",
        "category": "control",
        "description": "Stop everything and end the program",
        "arduinoApi": "Melo.halt()",
        "codegen": "Melo.halt();",
        "blockLabel": "End Program",
        "inputs": [],
        "outputs": [],
        "blocking": false,
        "errors": [
          "MELO_ERR_NOT_INIT"
        ]
      }
    ],
    "systemApi": [
      "begin",
      "isReady",
      "getSdkVersion",
      "getDeviceInfo",
      "lastError",
      "lastErrorMessage",
      "statusMessage",
      "printStatus",
      "trimWheel",
      "resetLineFollow",
      "irRaw",
      "readLightRaw",
      "portRaw",
      "portOhms"
    ],
    "errorCodes": [
      {
        "id": "MELO_OK",
        "value": 0,
        "message": "OK"
      },
      {
        "id": "MELO_ERR_NOT_INIT",
        "value": 1,
        "message": "Melo is not set up. Call Melo.begin() first."
      },
      {
        "id": "MELO_ERR_INVALID_ARG",
        "value": 2,
        "message": "A value was out of range."
      },
      {
        "id": "MELO_ERR_PIN",
        "value": 3,
        "message": "A pin could not be set up. Check the wiring."
      },
      {
        "id": "MELO_ERR_LINE_LOST",
        "value": 4,
        "message": "The line was lost."
      }
    ]
  }
}
